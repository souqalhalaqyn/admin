{
  "expo": {
    "name": "Barber Admin",
    "slug": "barbers-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "barbersadmin",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rawadag.barbersadmin"
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/logo.png",
          "android": {
            "image": "./assets/logo.png",
            "imageWidth": 300
          }
        }
      ],
      "expo-localization",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14760687-3f8f-4af1-ab7c-c8b689bc16b6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/14760687-3f8f-4af1-ab7c-c8b689bc16b6",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "souqalhalaqeen-organaization"
  }
}
