{
  "expo": {
    "name": "Barber Admin",
    "slug": "barbers-admin",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/1024x1024.png",
    "scheme": "barbersadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rawadag.barbersadmin"
    },
    "splash": {
      "image": "./assets/300x300.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/1024x1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rawadag.barbersadmin",
      "googleServicesFile": "./google-services.json"
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/300x300.png",
          "android": {
            "image": "./assets/300x300.png",
            "imageWidth": 300
          }
        }
      ],
      "expo-localization",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/1024x1024.png",
          "color": "#121212",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      ["./plugins/withLocalizedAppLabel.js", { "ar": "ادمن سوق الحلاقين" }],
      "./plugins/withApkInstaller.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14760687-3f8f-4af1-ab7c-c8b689bc16b6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/14760687-3f8f-4af1-ab7c-c8b689bc16b6",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkOnLaunch": "ALWAYS"
    },
    "runtimeVersion": "1.0.0",
    "owner": "souqalhalaqeen-organaization",
    "developmentClient": {
      "silentLaunch": false,
      "android": {
        "package": "com.rawadag.barbersadmin.debug"
      }
    }
  }
}
