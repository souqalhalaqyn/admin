{
  "name": "barbers-admin",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start --localhost",
    "lint": "expo lint",
    "ota": "eas update --channel production --auto --message \"updates\"",
    "build-dev": "npx eas build --platform android --profile development",
    "build-prod": "npx eas build --platform android --profile production",
    "url": "eas build:list --profile production --non-interactive --json --limit=1 | jq -r '.[] | select(.status==\"FINISHED\") | .artifacts.applicationArchiveUrl'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/drawer": "^7.9.4",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "expo": "~55.0.26",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.18",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.0",
    "expo-intent-launcher": "~55.0.14",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.15",
    "expo-notifications": "~55.0.24",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.17",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.15",
    "i18next": "^26.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "reanimated-color-picker": "^5.1.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
